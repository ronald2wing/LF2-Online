<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LF2 Online Lobby</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { height:100%; }
  body {
    background:#0e0e18;
    color:#e8ecff;
    font-family:Helvetica,Arial,sans-serif;
    font-size:13px;
    overflow:hidden;
  }
  .lobby {
    display:grid;
    grid-template-columns:1fr 264px;
    height:100%;
  }
  .pane { display:flex; flex-direction:column; min-height:0; min-width:0; }
  .roster-pane { border-right:1px solid #2b2b45; }

  /* ── status bar: what is happening, and what to do about it ───────────── */
  .statusbar {
    display:flex;
    align-items:center;
    gap:8px;
    min-height:38px;
    padding:6px 12px;
    background:#161628;
    border-bottom:1px solid #2b2b45;
  }
  .status { flex:1; color:#9b9bff; line-height:1.35; }
  .status.error { color:#ff9a9a; }
  .status.success { color:#8fe6a8; }
  .prompt-actions { display:flex; gap:6px; }
  .prompt-actions:empty { display:none; }

  /* ── roster ───────────────────────────────────────────────────────────── */
  .roster-head {
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    padding:10px 12px 6px;
  }
  .roster-head h2, .side h2 {
    font-size:11px;
    font-weight:bold;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:#7f8fc4;
  }
  .count { color:#6f7fb5; font-size:11px; }
  .roster { flex:1; overflow-y:auto; padding:0 12px 12px; }

  .row {
    display:flex;
    align-items:center;
    gap:10px;
    padding:9px 10px;
    background:#1a1a30;
    border:1px solid #2b2b45;
    border-radius:3px;
    margin-bottom:6px;
  }
  .row .who { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .row .who b { font-weight:bold; }
  .badge {
    font-size:10px;
    letter-spacing:.05em;
    text-transform:uppercase;
    color:#8fa4f0;
    border:1px solid #3d55b0;
    border-radius:2px;
    padding:1px 5px;
    white-space:nowrap;
  }
  .badge.busy { color:#c9a0ff; border-color:#6b4fa8; }
  .badge.pending { color:#ffd479; border-color:#8a6a2f; }
  .empty {
    color:#6f7fb5;
    text-align:center;
    padding:24px 0;
    border:1px dashed #2b2b45;
    border-radius:3px;
  }

  /* ── sidebar ──────────────────────────────────────────────────────────── */
  .side { background:#12121f; }
  .side section { padding:10px 12px; }
  .you { border-bottom:1px solid #2b2b45; }
  .you label { display:block; color:#7f8fc4; font-size:11px; text-transform:uppercase; letter-spacing:.08em; margin-bottom:6px; }
  .you input {
    width:100%;
    padding:7px 9px;
    font:inherit;
    color:#fff;
    background:#1a1a30;
    border:1px solid #3d55b0;
    border-radius:3px;
  }
  .you input:focus-visible { outline:2px solid #5a75de; outline-offset:1px; }
  .server { margin-top:6px; color:#6f7fb5; font-size:11px; word-break:break-all; }

  .feed-wrap { flex:1; display:flex; flex-direction:column; min-height:0; padding-bottom:0; }
  .feed-wrap h2 { margin-bottom:6px; }
  .feed {
    flex:1;
    overflow-y:auto;
    font-size:12px;
    line-height:1.45;
    word-wrap:break-word;
  }
  .feed .line { margin-bottom:4px; color:#b9c6f5; }
  .feed .line .who { color:#8fa4f0; font-weight:bold; }
  .feed .line.sys { color:#6f7fb5; font-style:italic; }

  .composer { display:flex; gap:6px; padding:10px 12px; border-top:1px solid #2b2b45; }
  .composer input {
    flex:1;
    min-width:0;
    padding:7px 9px;
    font:inherit;
    color:#fff;
    background:#1a1a30;
    border:1px solid #2b2b45;
    border-radius:3px;
  }
  .composer input:focus-visible { outline:2px solid #5a75de; outline-offset:1px; }

  /* ── buttons ──────────────────────────────────────────────────────────── */
  .btn {
    padding:6px 12px;
    font:inherit;
    font-weight:bold;
    color:#fff;
    background:#3d55b0;
    border:1px solid #4a63c4;
    border-radius:3px;
    cursor:pointer;
    white-space:nowrap;
  }
  .btn:hover:not(:disabled) { background:#4a63c4; }
  .btn:focus-visible { outline:2px solid #8fa4f0; outline-offset:1px; }
  .btn:disabled { background:#23233a; border-color:#2b2b45; color:#5c6485; cursor:default; }
  .btn.primary { background:#1878ca; border-color:#248ce5; }
  .btn.primary:hover:not(:disabled) { background:#248ce5; }
  .hidden { display:none !important; }
</style>
</head>
<body>
<div class="lobby">
  <main class="pane roster-pane">
    <div class="statusbar">
      <span class="status" id="status" role="status" aria-live="polite">Connecting…</span>
      <span class="prompt-actions">
        <button class="btn primary hidden" id="acceptBtn" type="button">Accept</button>
        <button class="btn hidden" id="declineBtn" type="button">Decline</button>
        <button class="btn hidden" id="cancelBtn" type="button">Cancel</button>
      </span>
    </div>
    <div class="roster-head">
      <h2>Players</h2>
      <span class="count" id="peerCount">0 online</span>
    </div>
    <div class="roster" id="peers"></div>
  </main>

  <aside class="pane side">
    <section class="you">
      <label for="nameInput">You are</label>
      <input id="nameInput" maxlength="24" autocomplete="off" spellcheck="false" aria-label="Your display name">
      <div class="server" id="serverInfo"></div>
    </section>
    <section class="feed-wrap">
      <h2>Room</h2>
      <div class="feed" id="feed" role="log"></div>
    </section>
    <form class="composer" id="composer">
      <input id="chatInput" maxlength="240" autocomplete="off" placeholder="Say something…" aria-label="Chat message">
      <button class="btn primary" type="submit">Send</button>
    </form>
  </aside>
</div>

<script>
(function () {
  "use strict"

  var NAME_KEY = "LF2 Online/name"
  var CHALLENGE_TIMEOUT_MS = 15000
  var FEED_LIMIT = 200
  var NAME_MAX = 24
  // Default names, used only when the player has not typed one. LF2's own cast,
  // so a first-time visitor still arrives recognisable.
  var NAME_POOL = [
    "Davis", "Firen", "Freeze", "Woody", "Dennis",
    "Louis", "Rudolf", "Henry", "John", "Deep"
  ]

  // The lobby is embedded by the game page, which sends the room and protocol
  // in its init message; these are only the fallbacks for a standalone visit.
  var room = "LF2 Online"
  var protocol = ""

  var myId = Math.random().toString(36).slice(2, 8)
  var myName = loadName()

  var ws
  // ActionCable routes a client message by the exact identifier string it
  // subscribed with (Subscriptions#find is a plain hash lookup), so this is
  // built once per connection and reused verbatim. A rename therefore travels
  // as its own message rather than by changing the identifier.
  var identifier = null
  var state = "idle"          // idle | outgoing | incoming | starting
  var peerId = null
  var timeoutId = null
  var stopped = false
  var lastRoster = {}         // id -> name, to report joins and departures
  var lastPeers = []          // the last roster payload, for re-renders
  // Origin of the parent frame (this game page), captured from the
  // browser-authenticated init message and reused as the target for every
  // reply below.
  var parentOrigin = location.origin

  var el = {
    status: document.getElementById("status"),
    peers: document.getElementById("peers"),
    peerCount: document.getElementById("peerCount"),
    feed: document.getElementById("feed"),
    composer: document.getElementById("composer"),
    chatInput: document.getElementById("chatInput"),
    nameInput: document.getElementById("nameInput"),
    serverInfo: document.getElementById("serverInfo"),
    accept: document.getElementById("acceptBtn"),
    decline: document.getElementById("declineBtn"),
    cancel: document.getElementById("cancelBtn")
  }

  function shortName(id) { return "Player " + String(id).slice(0, 4) }

  function displayName(peer) { return peer.name || shortName(peer.id) }

  // ── identity ─────────────────────────────────────────────────────────────

  function loadName() {
    var stored = null
    try { stored = localStorage.getItem(NAME_KEY) } catch (e) { /* storage may be blocked */ }
    if (stored && stored.trim()) return stored.trim().slice(0, NAME_MAX)
    return NAME_POOL[Math.floor(Math.random() * NAME_POOL.length)]
  }

  function saveName(name) {
    try { localStorage.setItem(NAME_KEY, name) } catch (e) { /* storage may be blocked */ }
  }

  // ── activity feed ────────────────────────────────────────────────────────

  function pushFeed(text, kind, who) {
    var line = document.createElement("div")
    line.className = "line" + (kind ? " " + kind : "")

    if (who) {
      var speaker = document.createElement("span")
      speaker.className = "who"
      speaker.textContent = who
      line.appendChild(speaker)
      line.appendChild(document.createTextNode(" " + text))
    } else {
      line.textContent = text
    }

    el.feed.appendChild(line)
    while (el.feed.childNodes.length > FEED_LIMIT) el.feed.removeChild(el.feed.firstChild)
    el.feed.scrollTop = el.feed.scrollHeight
  }

  // ── status + buttons ─────────────────────────────────────────────────────

  function setStatus(text, kind) {
    el.status.textContent = text
    el.status.className = "status" + (kind ? " " + kind : "")
  }

  function render() {
    el.accept.classList.toggle("hidden", state !== "incoming")
    el.decline.classList.toggle("hidden", state !== "incoming")
    el.cancel.classList.toggle("hidden", state !== "outgoing")
    renderRoster()
  }

  function clearChallengeTimeout() {
    if (timeoutId) { clearTimeout(timeoutId); timeoutId = null }
  }

  function armTimeout() {
    clearChallengeTimeout()
    timeoutId = setTimeout(function () {
      if (state === "outgoing") {
        send({ type: "cancel", to: peerId })
        resolve("No response from " + shortName(peerId), "error")
      } else if (state === "incoming") {
        send({ type: "decline", to: peerId })
        resolve(shortName(peerId) + " timed out", "error")
      }
    }, CHALLENGE_TIMEOUT_MS)
  }

  function resolve(message, kind) {
    clearChallengeTimeout()
    state = "idle"
    peerId = null
    setStatus(message, kind)
    render()
  }

  // ── signaling connection ─────────────────────────────────────────────────

  function connect() {
    if (stopped) return
    if (ws && ws.readyState !== WebSocket.CLOSED) return
    var scheme = location.protocol === "https:" ? "wss:" : "ws:"
    ws = new WebSocket(scheme + "//" + location.host + "/cable")

    ws.onopen = function () {
      setStatus("Connected")
      identifier = JSON.stringify({
        channel: "GameChannel",
        room: room,
        client_id: myId,
        name: myName
      })
      ws.send(JSON.stringify({ command: "subscribe", identifier: identifier }))
    }

    ws.onmessage = function (event) {
      var msg = JSON.parse(event.data)
      if (msg.type === "confirm_subscription") {
        setStatus("Waiting for another player…")
        send({ type: "presence" })
      } else if (msg.message) {
        handleMessage(msg.message)
      }
    }

    ws.onclose = function () {
      clearChallengeTimeout()
      state = "idle"
      peerId = null
      setStatus("Disconnected. Reconnecting…", "error")
      render()
      if (!stopped) setTimeout(connect, 3000)
    }
    ws.onerror = function () { setStatus("Connection error", "error") }
  }

  // Closes the lobby's signaling connection and disables its reconnect loop.
  // Called once the game starts so the lobby stops holding the client_id that
  // the WebRTC transport subscribes under — otherwise the lobby's reconnect
  // loop can overwrite the transport's room slot and break signaling mid-game.
  function stop() {
    stopped = true
    clearChallengeTimeout()
    if (ws) {
      ws.onclose = null
      ws.close()
      ws = null
    }
  }

  function send(data) {
    if (!ws || ws.readyState !== WebSocket.OPEN || !identifier) return
    ws.send(JSON.stringify({
      command: "message",
      identifier: identifier,
      data: JSON.stringify(data)
    }))
  }

  // ── incoming messages ────────────────────────────────────────────────────

  function handleMessage(data) {
    switch (data.type) {
      case "peers":
        renderPeers(data.peers || [])
        break

      case "chat":
        pushFeed(data.text, null, data.name || shortName(data.from))
        break

      case "challenge":
        handleChallenge(data.from)
        break

      case "accept":
        if (state !== "outgoing" || data.from !== peerId) return
        clearChallengeTimeout()
        state = "starting"
        peerId = data.from
        setStatus("Challenge accepted — starting the game…", "success")
        render()
        send({ type: "start_game", id1: myId, id2: data.from })
        break

      case "decline":
        if (state !== "outgoing" || data.from !== peerId) return
        resolve(shortName(data.from) + " declined", "error")
        break

      case "cancel":
        if (state !== "incoming" || data.from !== peerId) return
        resolve(shortName(data.from) + " cancelled the challenge", "error")
        break

      case "game_start":
        stop()
        window.parent.postMessage({
          event: "start",
          role: data.id1 === myId ? "active" : "passive",
          id1: data.id1,
          id2: data.id2
        }, parentOrigin)
        break
    }
  }

  // ── roster ───────────────────────────────────────────────────────────────

  // State as the roster shows it, which is the room's availability plus
  // whatever challenge is in flight locally.
  function peerState(peer) {
    if (peer.id === peerId && (state === "outgoing" || state === "incoming")) return "challenged"
    if (peer.state === "playing") return "busy"
    return "available"
  }

  var STATE_LABEL = { available: "Available", busy: "In match", challenged: "Challenged" }

  function renderPeers(peers) {
    var others = peers.filter(function (p) { return p.id !== myId })
    var seen = {}

    // Report roster churn into the feed, so the room reads as a room.
    others.forEach(function (p) {
      seen[p.id] = p.name
      if (!lastRoster[p.id]) pushFeed(displayName(p) + " joined the lobby", "sys")
    })
    Object.keys(lastRoster).forEach(function (id) {
      if (!seen[id]) pushFeed((lastRoster[id] || shortName(id)) + " left the lobby", "sys")
    })
    lastRoster = seen
    lastPeers = others

    // A challenge whose target vanished is over.
    if (state !== "idle" && peerId && !seen[peerId]) {
      resolve(shortName(peerId) + " left the lobby", "error")
    }

    el.peerCount.textContent = (others.length + 1) + " online"

    renderRoster()

    if (state === "idle") {
      setStatus(others.length === 0
        ? "Waiting for another player…"
        : "Pick an opponent and press Challenge")
    }
  }

  function renderRoster() {
    el.peers.textContent = ""

    if (lastPeers.length === 0) {
      var empty = document.createElement("div")
      empty.className = "empty"
      empty.textContent = "No other players yet"
      el.peers.appendChild(empty)
      return
    }

    lastPeers.forEach(function (peer) {
      var kind = peerState(peer)
      var row = document.createElement("div")
      row.className = "row"

      row.appendChild(nameSpan(displayName(peer)))
      row.appendChild(badge(kind, STATE_LABEL[kind]))

      var challenge = document.createElement("button")
      challenge.type = "button"
      challenge.className = "btn"
      challenge.textContent = "Challenge"
      // A player already in a match cannot be challenged; the server refuses it
      // too, this only keeps the button honest.
      challenge.disabled = state !== "idle" || kind === "busy"
      challenge.onclick = function () { challengePeer(peer.id) }
      row.appendChild(challenge)

      el.peers.appendChild(row)
    })
  }

  function nameSpan(text) {
    var span = document.createElement("span")
    span.className = "who"
    var b = document.createElement("b")
    b.textContent = text
    span.appendChild(b)
    return span
  }

  function badge(kind, label) {
    var span = document.createElement("span")
    span.className = "badge" + (kind === "busy" ? " busy" : kind === "challenged" ? " pending" : "")
    span.textContent = label
    return span
  }

  // ── challenge flow ───────────────────────────────────────────────────────

  function challengePeer(id) {
    if (state !== "idle") return
    state = "outgoing"
    peerId = id
    send({ type: "challenge", to: id })
    setStatus("Challenging " + (lastRoster[id] || shortName(id)) + "…")
    pushFeed("You challenged " + (lastRoster[id] || shortName(id)), "sys")
    armTimeout()
    render()
  }

  function cancelChallenge() {
    if (state !== "outgoing") return
    send({ type: "cancel", to: peerId })
    resolve("Challenge cancelled", null)
  }

  function acceptChallenge() {
    if (state !== "incoming") return
    clearChallengeTimeout()
    var from = peerId
    state = "starting"
    setStatus("Challenge accepted — starting the game…", "success")
    render()
    // Only the challenger ("active" peer) sends start_game, in response to this
    // accept. Sending it here too would broadcast game_start twice and make the
    // parent spin up the WebRTC transport twice.
    send({ type: "accept", to: from, role: "passive" })
  }

  function declineChallenge() {
    if (state !== "incoming") return
    send({ type: "decline", to: peerId })
    resolve("Challenge declined", null)
  }

  function handleChallenge(fromId) {
    if (state === "outgoing") {
      // Simultaneous mutual challenge: the lexicographically smaller id stays
      // the challenger; the larger id yields and accepts the incoming one.
      if (myId < fromId) return
      clearChallengeTimeout()
      state = "idle"
      peerId = null
    } else if (state !== "idle") {
      send({ type: "decline", to: fromId })
      return
    }
    state = "incoming"
    peerId = fromId
    var name = lastRoster[fromId] || shortName(fromId)
    setStatus(name + " challenges you")
    pushFeed(name + " challenges you", "sys")
    armTimeout()
    render()
  }

  // ── chat ─────────────────────────────────────────────────────────────────

  el.composer.onsubmit = function (event) {
    event.preventDefault()
    var text = el.chatInput.value.trim()
    if (!text) return
    // The server broadcasts to the whole room, this client included, so the
    // message is appended when it comes back rather than here.
    send({ type: "chat", text: text })
    el.chatInput.value = ""
  }

  el.nameInput.value = myName
  el.nameInput.onchange = function () {
    var name = el.nameInput.value.trim().slice(0, NAME_MAX)
    if (!name) {
      el.nameInput.value = myName
      return
    }
    myName = name
    el.nameInput.value = name
    saveName(name)
    send({ type: "set_name", name: name })
  }

  el.accept.onclick = acceptChallenge
  el.decline.onclick = declineChallenge
  el.cancel.onclick = cancelChallenge

  document.addEventListener("keydown", function (event) {
    // Escape and Enter are lobby shortcuts only while the player is not typing.
    var typing = event.target && /^(INPUT|TEXTAREA)$/.test(event.target.tagName)
    if (typing && event.key !== "Escape") return
    if (event.key === "Escape") {
      if (typing) { event.target.blur(); return }
      if (state === "outgoing") cancelChallenge()
      else if (state === "incoming") declineChallenge()
    } else if (event.key === "Enter" && state === "incoming") {
      event.preventDefault()
      acceptChallenge()
    }
  })

  render()

  window.addEventListener("message", function (event) {
    // Only the parent frame may drive the lobby: reject any other sender, then
    // record the parent's real origin (reported by the browser) so the replies
    // above target it directly instead of "*".
    if (event.source !== window.parent) return
    if (event.data && event.data.init) {
      parentOrigin = event.origin
      // The parent knows which room and server it opened; trust it over the
      // standalone fallbacks.
      if (event.data.room) room = event.data.room
      if (event.data.protocol) protocol = event.data.protocol
      el.serverInfo.textContent = protocol
      connect()
    }
  })

  setTimeout(connect, 100)
})()
</script>
</body>
</html>
